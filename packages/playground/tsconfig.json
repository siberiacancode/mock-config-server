{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ESNext"],
    "paths": {
      "@/shared/*": ["../shared/*"],
      "@/core/*": ["./src/core/*"],
      "@/utils/*": ["./src/utils/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true
  },
  "exclude": ["node_modules"]
}
